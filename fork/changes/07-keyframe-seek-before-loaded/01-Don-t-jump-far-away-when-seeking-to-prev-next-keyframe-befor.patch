index 00000000..525ea917
--- /dev/null
+++ b/src/renderer/src/util/keyframes.test.ts
@@ -0,0 +1,14 @@
+import { test, expect } from 'vitest';
+
+import { isRangeScanned } from './keyframes';
+
+test('isRangeScanned', () => {
+  expect(isRangeScanned([], 1, 2)).toBe(false);
+  expect(isRangeScanned([{ from: 0, to: 60 }], 10, 20)).toBe(true);
+  expect(isRangeScanned([{ from: 0, to: 60 }], 20, 10)).toBe(true); // reversed
+  expect(isRangeScanned([{ from: 0, to: 60 }], 50, 70)).toBe(false);
+  expect(isRangeScanned([{ from: 30, to: 90 }, { from: 0, to: 60 }], 10, 80)).toBe(true); // overlapping, unsorted
+  expect(isRangeScanned([{ from: 0, to: 60 }, { from: 60, to: 120 }], 10, 110)).toBe(true); // touching
+  expect(isRangeScanned([{ from: 0, to: 60 }, { from: 600, to: 660 }], 30, 630)).toBe(false); // gap
+  expect(isRangeScanned([{ from: 0, to: 60 }], 60, 60)).toBe(true);
+});
diff --git a/src/renderer/src/util/keyframes.ts b/src/renderer/src/util/keyframes.ts
new file mode 100644
index 00000000..7ddf982e
--- /dev/null
+++ b/src/renderer/src/util/keyframes.ts
@@ -0,0 +1,23 @@
+export interface ScannedInterval {
+  from: number,
+  to: number,
+  createdAt: Date,
+}
+
+/**
+ * Returns true if the whole range [from, to] is covered by the union of the given intervals,
+ * i.e. we have actually read all packets in that range, so we know every keyframe in it.
+ */
+export function isRangeScanned(intervals: Pick<ScannedInterval, 'from' | 'to'>[], from: number, to: number) {
+  const start = Math.min(from, to);
+  const end = Math.max(from, to);
+
+  let reached = start;
+  const sorted = [...intervals].sort((a, b) => a.from - b.from);
+  for (const interval of sorted) {
+    if (interval.from > reached) break; // gap
+    if (interval.to > reached) reached = interval.to;
+    if (reached >= end) return true;
+  }
+  return reached >= end;
+}
