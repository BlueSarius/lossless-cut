@@ -0,0 +1,63 @@
+import { describe, it, expect } from 'vitest';
+
+import { createHistory, getCurrentState, pushHistory, redoHistory, undoHistory } from './history';
+
+const pushAll = (states: string[], capacity: number) => states.reduce((h, s) => pushHistory(h, s, capacity), createHistory('s0'));
+
+describe('history', () => {
+  it('undoes and redoes', () => {
+    let h = pushAll(['s1', 's2'], 10);
+    expect(getCurrentState(h)).toBe('s2');
+    h = undoHistory(h);
+    expect(getCurrentState(h)).toBe('s1');
+    h = undoHistory(h);
+    expect(getCurrentState(h)).toBe('s0');
+    h = undoHistory(h);
+    expect(getCurrentState(h)).toBe('s0');
+    h = redoHistory(redoHistory(redoHistory(h)));
+    expect(getCurrentState(h)).toBe('s2');
+  });
+
+  it('undoes one step at a time after capacity has been exceeded', () => {
+    let h = pushAll(['s1', 's2', 's3', 's4'], 3);
+    expect(h.entries).toEqual(['s2', 's3', 's4']);
+    h = undoHistory(h);
+    expect(getCurrentState(h)).toBe('s3');
+    h = undoHistory(h);
+    expect(getCurrentState(h)).toBe('s2');
+    h = undoHistory(h);
+    expect(getCurrentState(h)).toBe('s2');
+  });
+
+  it('drops redo entries when a new state is pushed', () => {
+    let h = undoHistory(pushAll(['s1', 's2'], 10));
+    h = pushHistory(h, 'x', 10);
+    expect(h.entries).toEqual(['s0', 's1', 'x']);
+    expect(getCurrentState(redoHistory(h))).toBe('x');
+  });
+
+  it('ignores unchanged state', () => {
+    const h = pushAll(['s1'], 10);
+    expect(pushHistory(h, 's1', 10)).toBe(h);
+  });
+
+  it('coalesces updates with the same key into one undo step', () => {
+    let h = pushAll(['s1'], 10);
+    h = pushHistory(h, 'drag1', 10, 'a');
+    h = pushHistory(h, 'drag2', 10, 'a');
+    h = pushHistory(h, 'drag3', 10, 'a');
+    expect(h.entries).toEqual(['s0', 's1', 'drag3']);
+    expect(getCurrentState(undoHistory(h))).toBe('s1');
+
+    // a different key starts a new step
+    h = pushHistory(h, 'other', 10, 'b');
+    expect(h.entries).toEqual(['s0', 's1', 'drag3', 'other']);
+  });
+
+  it('does not coalesce into an entry reached by undo', () => {
+    let h = pushHistory(pushAll(['s1'], 10), 'drag1', 10, 'a');
+    h = redoHistory(undoHistory(h));
+    h = pushHistory(h, 'drag2', 10, 'a');
+    expect(h.entries).toEqual(['s0', 's1', 'drag1', 'drag2']);
+  });
+});
diff --git a/src/renderer/src/util/history.ts b/src/renderer/src/util/history.ts
new file mode 100644
index 00000000..eefd948a
--- /dev/null
+++ b/src/renderer/src/util/history.ts
@@ -0,0 +1,49 @@
+// Pure undo/redo history, used by `useStateWithHistory`.
+// Replaces react-use's useStateWithHistory, which has an off-by-one bug once `capacity` is reached:
+// the position ends up one past the last entry, so the first undo after every edit does nothing.
+
+export interface History<T> {
+  entries: T[],
+  position: number,
+  // set when the current entry was created with a coalesceKey, so that the next update with the same key can be merged into it
+  coalesceKey?: string | undefined,
+}
+
+export interface SetStateWithHistoryOptions {
+  // Successive updates with the same key are merged into a single undo step (e.g. while dragging)
+  coalesceKey?: string | undefined,
+}
+
+export function createHistory<T>(initialState: T): History<T> {
+  return { entries: [initialState], position: 0 };
+}
+
+export const getCurrentState = <T>(history: History<T>) => history.entries[history.position]!;
+
+export function pushHistory<T>(history: History<T>, newState: T, capacity: number, coalesceKey?: string | undefined): History<T> {
+  if (newState === getCurrentState(history)) return history;
+
+  const isAtEnd = history.position === history.entries.length - 1;
+
+  // Merge successive updates with the same key (e.g. while dragging) into a single undo step
+  if (coalesceKey != null && coalesceKey === history.coalesceKey && isAtEnd) {
+    const entries = [...history.entries];
+    entries[history.position] = newState;
+    return { entries, position: history.position, coalesceKey };
+  }
+
+  // drop any redo entries, then add the new one
+  let entries = [...history.entries.slice(0, history.position + 1), newState];
+  if (entries.length > capacity) entries = entries.slice(entries.length - capacity);
+  return { entries, position: entries.length - 1, coalesceKey };
+}
+
+export function undoHistory<T>(history: History<T>): History<T> {
+  if (history.position <= 0) return history;
+  return { entries: history.entries, position: history.position - 1 };
+}
+
+export function redoHistory<T>(history: History<T>): History<T> {
+  if (history.position >= history.entries.length - 1) return history;
+  return { entries: history.entries, position: history.position + 1 };
+}
